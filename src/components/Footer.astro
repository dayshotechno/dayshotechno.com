---
// Section H — monospace social index + legal links (Austrian Impressum requirement).
const socials = [
  { label: "INSTAGRAM", href: "https://instagram.com/daysho.techno" },
  { label: "TIKTOK", href: "https://www.tiktok.com/@daysho.dj" },
  { label: "SOUNDCLOUD", href: "https://on.soundcloud.com/0Oiz8yh04PoAh92DmF" },
];
---

<footer class="border-t border-primary bg-void">
  <div class="shell flex flex-col gap-8 py-12 md:flex-row md:items-end md:justify-between">
    <nav aria-label="Social media">
      <p class="font-mono text-[11px] uppercase tracking-widest text-muted">EXTERNAL_CHANNELS:</p>
      <ul class="mt-3 space-y-2">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="glitch-hover font-mono text-sm uppercase tracking-widest text-content hover:text-primary"
              >
                &gt; {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="font-mono text-[11px] uppercase tracking-widest text-muted md:text-right">
      <p>
        <a href="/impressum" class="hover:text-content underline underline-offset-4">IMPRESSUM</a>
        <span class="mx-2">/</span>
        <a href="/datenschutz" class="hover:text-content underline underline-offset-4">DATENSCHUTZ</a>
      </p>
      <p class="mt-3">
        © {new Date().getFullYear()} DAY SHO // <span class="text-scan">ALL SYSTEMS OPERATIONAL</span>
      </p>
    </div>
  </div>
</footer>
