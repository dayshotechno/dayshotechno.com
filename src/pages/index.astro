---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import AudioFeed from "../components/AudioFeed.astro";
import BioSystem from "../components/BioSystem.astro";
import StageTimeline from "../components/StageTimeline.astro";
import TechRider from "../components/TechRider.astro";
import PressAssets from "../components/PressAssets.astro";
import BookingForm from "../components/BookingForm.astro";
import Footer from "../components/Footer.astro";
import dims from "../data/images.json";
---

<Layout>
  <HeroSection />

  <main id="main">
    <div class="divider-stripes" aria-hidden="true"></div>
    <AudioFeed />

    <div class="divider-stripes divider-stripes--bw" aria-hidden="true"></div>
    <BioSystem />

    <div class="divider-stripes" aria-hidden="true"></div>
    <StageTimeline />

    <div class="divider-stripes divider-stripes--bw" aria-hidden="true"></div>
    <TechRider />

    <div class="divider-stripes" aria-hidden="true"></div>
    <PressAssets />

    <!-- Studio triptych, full bleed. Site-only imagery: the outer two frames are
         AI-generated extensions of the centre shoot and are deliberately excluded
         from presskit.zip and the press download list. -->
    <div class="triptych" aria-hidden="true">
      {
        ["studio_side", "press_05", "studio_walk"].map((name) => (
          <figure>
            <img
              src={`/assets/${name}.webp`}
              alt=""
              loading="lazy"
              width={dims[name].w}
              height={dims[name].h}
            />
          </figure>
        ))
      }
    </div>

    <div class="divider-stripes divider-stripes--bw" aria-hidden="true"></div>

    <!-- Section G — INITIATE_CONTACT -->
    <section id="booking" class="mx-auto w-full max-w-7xl px-4 py-20 md:py-28">
      <h2 class="font-mono text-2xl font-bold uppercase tracking-widest text-content md:text-4xl">
        <span class="text-primary">//</span> INITIATE_CONTACT<span class="cursor-blink"></span>
      </h2>
      <p class="mt-2 font-mono text-xs uppercase tracking-widest text-muted">
        BOOKING REQUESTS ONLY // RESPONSE WITHIN 48H
      </p>

      <div class="mt-10 max-w-3xl border border-[#333] bg-surface p-6 md:p-10">
        <BookingForm />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
