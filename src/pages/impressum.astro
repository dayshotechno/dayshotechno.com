---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Impressum | DAY SHO" description="Impressum und rechtliche Angaben zu DAY SHO." noindex lang="de">
  <main id="main" class="shell legal">
    <h1 class="h2">Impressum</h1>

    <div class="legal-body">
      <p>
        <span class="soft">Diensteanbieter &amp; Medieninhaber:</span><br />
        Patrick Schlauer<br />
        Plüddemanngasse 47a<br />
        8010 Graz, Österreich
      </p>
      <p>
        <span class="soft">Kontakt:</span><br />
        E-Mail: <a href="mailto:pschlauer@icloud.com" class="link">pschlauer@icloud.com</a><br />
        Telefon: +43 664 3502534
      </p>
      <p>
        <span class="soft">Unternehmensgegenstand:</span> Musikproduktion &amp; DJ-Dienstleistungen<br />
        <span class="soft">Grundlegende Richtung:</span> Präsentation der künstlerischen Tätigkeit als DJ (DAY SHO).
      </p>
    </div>

    <a href="/" class="btn btn--ghost legal-back">Zurück zum Press Kit</a>
  </main>
  <style is:global>
    .legal {
      max-width: 46rem;
      padding-block: clamp(4rem, 10vw, 8rem);
    }

    .legal-body {
      display: grid;
      gap: 1.25rem;
      margin-top: 2.5rem;
      max-width: 62ch;
    }

    .legal-back {
      margin-top: 3rem;
    }
  </style>
</Layout>
