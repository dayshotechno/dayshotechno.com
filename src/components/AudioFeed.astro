---
// Section B — video reel in a damaged-CRT frame + link out to the SoundCloud archive.
---

<section id="audio-feed" class="blueprint relative mx-auto w-full max-w-7xl px-4 py-20 md:py-28">
  <h2 class="font-mono text-2xl font-bold uppercase tracking-widest text-content md:text-4xl">
    <span class="text-primary">//</span> AUDIO_FEED<span class="cursor-blink"></span>
  </h2>
  <p class="mt-2 font-mono text-xs uppercase tracking-widest text-muted">
    LIVE TRANSMISSION ARCHIVE // VISUAL EVIDENCE
  </p>

  <div class="mt-10 grid gap-8 md:grid-cols-3">
    <!-- CRT video reel -->
    <figure class="crt-frame md:col-span-2">
      <div class="flex items-center justify-between border-b border-[#333] px-3 py-2">
        <span class="font-mono text-[11px] uppercase tracking-widest text-muted">VISUAL_FEED_01 // LIVE_LOOP</span>
        <span class="font-mono text-[11px] uppercase tracking-widest text-scan">● REC</span>
      </div>
      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        class="block w-full"
        aria-label="DAY SHO live loop"
      >
        <source src="/assets/desktop-loop.mp4" type="video/mp4" media="(min-width: 769px)" />
        <source src="/assets/mobile-loop.mp4" type="video/mp4" />
      </video>
      <figcaption class="sr-only">Live visual loop of DAY SHO performing.</figcaption>
    </figure>

    <!-- Archive link block -->
    <div class="flex flex-col justify-between border border-[#333] bg-surface p-6">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-primary">ARCHIVE_ACCESS</p>
        <p class="mt-4 font-display text-xl font-bold uppercase leading-tight text-content">
          Full mix archive on SoundCloud.
        </p>
        <p class="mt-3 font-mono text-xs uppercase leading-relaxed tracking-wider text-muted">
          Latest sets, raw recordings, no filler.
        </p>
      </div>
      <a
        href="https://on.soundcloud.com/0Oiz8yh04PoAh92DmF"
        target="_blank"
        rel="noopener noreferrer"
        class="switch-btn glitch-hover mt-8"
      >
        &gt; OPEN_SOUNDCLOUD
      </a>
    </div>
  </div>
</section>
