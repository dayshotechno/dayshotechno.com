---
// Section C — the "Data Sheet": three bio lengths, each copy-to-clipboard.
import { BIOS as bios } from "../data/bio";
---

<section id="bio" class="mx-auto w-full max-w-7xl px-4 py-20 md:py-28">
  <div class="grid gap-10 md:grid-cols-[1fr_2fr]">
    <!-- Left: oversized display title -->
    <div>
      <div class="sticky top-8">
        <h2
          class="font-display font-bold uppercase leading-[0.9] text-content"
          style="font-size: clamp(3rem, 8vw, 8rem);"
        >
          BIO<span class="cursor-blink text-[0.35em] align-middle"></span>
        </h2>
        <p class="mt-4 font-mono text-xs uppercase tracking-widest text-muted">
          SUBJECT: DAY SHO<br />
          CLASS: HARD_TECHNO / SCHRANZ<br />
          STATUS: <span class="text-scan">OPERATIONAL</span>
        </p>
      </div>
    </div>

    <!-- Right: terminal containers -->
    <div class="space-y-6">
      {
        bios.map((bio) => (
          <article class="border border-[#333] bg-surface" data-bio={bio.id}>
            <header class="flex items-center justify-between gap-2 border-b border-[#333] px-4 py-2">
              <h3 class="font-mono text-xs uppercase tracking-widest text-primary">{bio.label}</h3>
              <button
                type="button"
                class="copy-btn glitch-hover shrink-0 border border-[#333] px-3 py-1 font-mono text-[11px] uppercase tracking-widest text-muted hover:border-primary hover:text-primary transition-colors"
                data-copy={bio.text}
              >
                [COPY]
              </button>
            </header>
            <p class="px-4 py-5 font-body text-sm leading-relaxed text-content md:text-base">{bio.text}</p>
          </article>
        ))
      }

      <!-- Contact sheet. Desaturated at rest so six frames from three different
           shoots read as one system; colour returns on the hovered frame only. -->
      <div class="grid grid-cols-2 gap-4 pt-4 md:grid-cols-4">
        {
          [
            { src: "/assets/press_01.webp", fig: "FIG_01", alt: "DAY SHO in profile against a concrete wall, lowering his sunglasses" },
            { src: "/assets/press_02.webp", fig: "FIG_02", alt: "DAY SHO facing the camera with headphones around his neck, reaching toward the lens" },
            { src: "/assets/press_03.webp", fig: "FIG_03", alt: "DAY SHO shielding his face with an outstretched hand in front of a concrete wall" },
            { src: "/assets/press_06.webp", fig: "FIG_04", alt: "DAY SHO mixing on Pioneer CDJs, headphones on, tattooed arms over the decks" },
          ].map((img) => (
            <figure class="press-frame aspect-[3/4]">
              <img src={img.src} alt={img.alt} loading="lazy" class="h-full w-full object-cover" />
              <figcaption class="press-frame__tag">{img.fig}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        const original = btn.textContent;
        btn.textContent = "[COPIED]";
        btn.classList.add("text-scan", "border-scan");
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove("text-scan", "border-scan");
        }, 1500);
      } catch {
        btn.textContent = "[FAILED]";
      }
    });
  });
</script>
