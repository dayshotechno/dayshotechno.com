---
// Rider: what the booth needs, as plain name columns. States a preference, not a
// condition — he has played a Xone:96 cold and came up on 900s. Keep the
// alternatives visible; do not put an ultimatum back.
import StepArrow from "./StepArrow.astro";

const groups = [
  {
    name: "Players",
    items: ["3× Pioneer CDJ-3000", "Linked via Pro DJ Link", "Current firmware"],
    alt: "Also fine: 3× CDJ-2000NXS2",
  },
  {
    name: "Mixer",
    items: ["Pioneer DJM-A9"],
    alt: "Also fine: Allen & Heath Xone:96 or DJM-900NXS2",
  },
  {
    name: "Booth",
    items: ["2 full-range monitors, adjustable from the booth", "Stable table at standing height", "2 free sockets, 230 V"],
  },
  {
    name: "Set",
    items: ["90–120 minutes", "145–160 BPM", "Best after the headliner"],
  },
];
---

<section id="rider" class="section">
  <div class="shell g12 rider-grid">
    <div class="rider-head" data-reveal>
      <h2 class="h2">Rider</h2>
      <p class="lead">Setup doesn’t match? Get in touch. It has been solved before.</p>
      <a href="/downloads/rider.txt" download class="btn btn--ghost">
        Download rider
        <StepArrow />
      </a>
    </div>

    <div class="rider-cols" data-reveal>
      {
        groups.map((g) => (
          <div class="rider-col">
            <h3 class="rider-col__name">{g.name}</h3>
            <ul>
              {g.items.map((i) => <li>{i}</li>)}
            </ul>
            {g.alt && <p class="rider-col__alt">{g.alt}</p>}
          </div>
        ))
      }
    </div>

    <div class="rider-gear" data-reveal>
      <figure>
        <img src="/assets/cdj3000.webp" alt="Pioneer CDJ-3000 player, top view" width="800" height="600" loading="lazy" />
        <figcaption class="small soft">CDJ-3000</figcaption>
      </figure>
      <figure>
        <img src="/assets/djma9.webp" alt="Pioneer DJM-A9 mixer, top view" width="800" height="600" loading="lazy" />
        <figcaption class="small soft">DJM-A9</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .rider-grid {
    row-gap: clamp(3rem, 6vw, 5rem);
  }

  .rider-head {
    grid-column: 1 / span 4;
  }

  .rider-head .lead {
    margin-block: 1.75rem 2rem;
    max-width: 18ch;
  }

  .rider-cols {
    grid-column: 5 / span 5;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) var(--gap);
    align-content: start;
  }

  .rider-col__name {
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .rider-col li {
    line-height: 1.4;
    padding-block: 0.15rem;
  }

  .rider-col__alt {
    margin-top: 0.75rem;
    font-size: var(--t-small);
    color: var(--c-primary);
  }

  .rider-gear {
    grid-column: 10 / span 3;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .rider-gear figure {
    background: var(--c-surface);
    padding: 1rem 1rem 0.75rem;
  }

  .rider-gear img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    filter: grayscale(0.4) contrast(1.1);
    transition: transform 0.4s var(--ease-out);
  }

  .rider-gear figure:hover img {
    transform: scale(1.05);
  }

  .rider-gear figcaption {
    margin-top: 0.5rem;
  }

  @media (max-width: 1023px) {
    .rider-head,
    .rider-cols,
    .rider-gear {
      grid-column: 1 / -1;
    }

    .rider-gear {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap);
    }
  }

  @media (max-width: 520px) {
    .rider-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
