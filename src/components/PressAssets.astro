---
// Press: the six press photos as one folded band, every frame a link to its file,
// then the three downloads. Real photography only: the AI-extended studio frames
// stay off this section and out of presskit.zip.
import dims from "../data/images.json";

const photos = [
  { name: "press_06", grow: 5, pos: "50% 30%", alt: "DAY SHO mixing on Pioneer gear, headphones on, tattooed arms over the decks" },
  { name: "press_02", grow: 2, pos: "50% 35%", alt: "DAY SHO facing the camera, headphones in his outstretched hand" },
  { name: "press_05", grow: 3, pos: "50% 30%", alt: "DAY SHO standing in a black studio, cap and leopard-print trousers" },
  { name: "press_03", grow: 2, pos: "38% 40%", alt: "DAY SHO with a bandana, adjusting headphones around his neck in a concrete room" },
  { name: "press_04", grow: 3, pos: "50% 60%", alt: "DAY SHO from behind in the booth, his name on his shirt, facing the crowd" },
  { name: "press_01", grow: 2, pos: "45% 30%", alt: "DAY SHO in profile against a concrete wall, lowering his sunglasses" },
] as const;

const downloads = [
  { href: "/downloads/presskit.zip", label: "Press kit", note: "Photos, logo pack and rider · ZIP, 6.6 MB", download: true },
  { href: "/downloads/rider.txt", label: "Rider", note: "Technical requirements · TXT", download: true },
  { href: "/one-sheet", label: "One-sheet", note: "Print it or save it as PDF", download: false },
];
---

<section id="press" class="section press">
  <div class="shell g12 press-head" data-reveal>
    <h2 class="h2">Press kit</h2>
    <p class="lead">Six photos, cleared for promotion. Tap any frame for the full file.</p>
  </div>

  <ul class="press-band" aria-label="Press photos">
    {
      photos.map((p) => (
        <li style={`--grow:${p.grow}`}>
          <a href={`/assets/${p.name}.webp`} target="_blank" rel="noopener">
            <img
              src={`/assets/${p.name}.webp`}
              alt={p.alt}
              width={dims[p.name].w}
              height={dims[p.name].h}
              loading="lazy"
              style={`object-position:${p.pos}`}
            />
            <span class="sr-only"> (opens the full-size file)</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="shell press-downloads" data-reveal>
    {
      downloads.map((d) => (
        <a href={d.href} class="press-dl" download={d.download ? "" : undefined}>
          <span class="press-dl__label">{d.label}</span>
          <span class="small soft">{d.note}</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .press-head {
    align-items: end;
    row-gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .press-head .h2 {
    grid-column: 1 / span 5;
  }

  .press-head .lead {
    grid-column: 7 / span 6;
    max-width: 30ch;
  }

  /* One folded view: unequal slices, no gaps, edge to edge. */
  .press-band {
    display: flex;
    height: 68svh;
    min-height: 26rem;
  }

  .press-band li {
    flex: var(--grow) 1 0;
    min-width: 0;
    overflow: hidden;
    transition: flex-grow 0.5s var(--ease-out);
  }

  .press-band a {
    display: block;
    height: 100%;
  }

  .press-band img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.12);
    transition:
      filter 0.4s,
      transform 0.6s var(--ease-out);
  }

  @media (hover: hover) {
    .press-band li:hover,
    .press-band li:focus-within {
      flex-grow: 6;
    }

    .press-band li:hover img,
    .press-band li:focus-within img {
      filter: grayscale(0) contrast(1.05);
    }
  }

  .press-band a:focus-visible {
    outline-offset: -4px;
  }

  /* A list set large, one download per row. */
  .press-downloads {
    display: grid;
    gap: 0.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .press-dl {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: 0.4rem var(--gap);
    padding: 1.1rem 1.25rem;
    background: var(--c-surface);
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.2s var(--ease-out);
  }

  .press-dl__label {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: var(--t-lead);
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: transform 0.25s var(--ease-out);
  }

  .press-dl:hover .press-dl__label,
  .press-dl:focus-visible .press-dl__label {
    transform: translateX(8px);
  }

  .press-dl:hover,
  .press-dl:focus-visible {
    background: var(--c-primary);
    color: var(--c-base);
  }

  .press-dl:hover .soft,
  .press-dl:focus-visible .soft {
    color: var(--c-base);
  }

  .press-dl:active {
    transform: translateY(2px);
  }

  @media (max-width: 1023px) {
    .press-head .h2,
    .press-head .lead {
      grid-column: 1 / -1;
    }

    .press-dl {
      grid-template-columns: 1fr;
    }
  }

  /* Phone: a 2 × 3 block, still unequal per row. */
  @media (max-width: 767px) {
    .press-band {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: 28svh;
      height: auto;
      min-height: 0;
    }

    .press-band li:nth-child(4n + 1),
    .press-band li:nth-child(4n + 4) {
      grid-column: span 2;
    }
  }
</style>
