---
// Listen: the claim, one set to play, and the booth on loop. A whole field of
// red, the colour of every DAY SHO flyer, so the first scroll changes the room.
// The old live loop (desktop-loop.mp4) was shot so dark it read as a black box on
// screen; the booth photograph does that job until a brighter clip exists.
import SoundCloudPlayer from "./SoundCloudPlayer.astro";
import StepArrow from "./StepArrow.astro";
import { CLAIM, EDITS } from "../data/bio";
import dims from "../data/images.json";
---

<section id="listen" class="listen section">
  <div class="shell g12 listen-grid">
    <div class="listen-copy" data-reveal>
      <h2 class="h2">{CLAIM.join(" ")}</h2>
      <p class="listen-lead lead">
        One set, start to finish. No breakdowns to hide behind, no runway before the drop.
      </p>
      <SoundCloudPlayer
        trackUrl="https://soundcloud.com/user-110221213/daysho-stockdunkel-dayrave"
        trackName="DAY SHO @ STOCKDUNKEL"
        note="Live at his own day-rave, Café Stockwerk · plays from SoundCloud"
      />
      <a
        href="https://on.soundcloud.com/0Oiz8yh04PoAh92DmF"
        target="_blank"
        rel="noopener noreferrer"
        class="listen-more"
      >
        Every set on SoundCloud
        <StepArrow />
      </a>

      <div class="edits">
        <h3 class="edits-title">Own edits, played in his sets</h3>
        <ul>
          {
            EDITS.map((e) => (
              <li class="edit">
                <span class="edit-name">
                  {e.artist} – {e.title} (DAY SHO Edit)
                  {e.bpm && <span class="edit-bpm tabular"> · {e.bpm} BPM</span>}
                </span>
              </li>
            ))
          }
        </ul>
        <a
          class="edit-ask"
          href={`mailto:booking@dayshotechno.com?subject=${encodeURIComponent("Edit request: DAY SHO")}&body=${encodeURIComponent("Hi DAY SHO, could you send me your edit of: ")}`}
        >
          DJ and want one? Ask for the file
          <StepArrow />
        </a>
      </div>
    </div>

    <figure class="listen-photo" data-reveal>
      <div class="listen-photo__frame">
        <img
          src="/assets/press_06.webp"
          alt="DAY SHO mixing, headphones on, both hands on the mixer"
          width={dims.press_06.w}
          height={dims.press_06.h}
          loading="lazy"
        />
      </div>
      <figcaption class="small">In the booth, mid-set.</figcaption>
    </figure>
  </div>
</section>

<style>
  .listen {
    background: var(--c-primary);
    color: var(--c-base);
  }

  .listen-grid {
    align-items: center;
    row-gap: 3.5rem;
  }

  .listen-copy {
    grid-column: 1 / span 6;
  }

  .listen-lead {
    max-width: 26ch;
    margin-top: 1.75rem;
    margin-bottom: 2.5rem;
  }

  .listen-more {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: text-decoration-thickness 0.2s;
  }

  .listen-more:hover,
  .listen-more:focus-visible {
    text-decoration-thickness: 4px;
  }

  .listen-more:hover :global(.step-arrow) {
    transform: translateX(4px);
  }

  .edits {
    margin-top: 3rem;
  }

  .edits-title {
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .edits ul {
    display: grid;
    gap: 0.5rem;
  }

  .edit {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding: 0.9rem 1.1rem;
    background: var(--c-base);
    color: var(--c-content);
  }

  .edit-name {
    font-weight: 700;
  }

  .edit-bpm {
    font-weight: 400;
    color: var(--c-soft);
  }


  .edit-ask {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: text-decoration-thickness 0.2s;
  }

  .edit-ask:hover,
  .edit-ask:focus-visible {
    text-decoration-thickness: 4px;
  }

  .edit-ask:hover :global(.step-arrow),
  .edit-ask:focus-visible :global(.step-arrow) {
    transform: translateX(4px);
  }

  .listen-photo {
    grid-column: 8 / span 5;
  }

  .listen-photo__frame {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--c-base);
  }

  .listen-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 35%;
    filter: grayscale(1) contrast(1.15);
  }

  /* The one moving picture: a slow push-in tied to the scroll. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .listen-photo img {
        animation: push-in linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }

  @keyframes push-in {
    from {
      transform: scale(1.18) translateY(4%);
    }
    to {
      transform: scale(1) translateY(-2%);
    }
  }

  .listen-photo figcaption {
    margin-top: 0.75rem;
  }

  @media (max-width: 1023px) {
    .listen-copy,
    .listen-photo {
      grid-column: 1 / -1;
    }

    .listen-photo__frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
