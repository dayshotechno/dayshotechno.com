---
// Click-to-load facade around the SoundCloud iframe. Nothing from SoundCloud is
// requested until the visitor presses play (performance + GDPR, see /datenschutz).
interface Props {
  trackUrl: string;
  trackName?: string;
  note?: string;
}

const { trackUrl, trackName = "Schranzlängenvergleich", note = "Full set · plays from SoundCloud" } = Astro.props;

const embedSrc =
  "https://w.soundcloud.com/player/?url=" +
  encodeURIComponent(trackUrl) +
  "&color=%23ff2a2a&auto_play=true&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false&theme=dark";
---

<div class="sc-player" data-embed-src={embedSrc}>
  <button type="button" class="sc-load">
    <span class="sc-play" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="currentColor"><path d="M3 1l11 7-11 7z"></path></svg>
    </span>
    <span class="sc-text">
      <span class="sc-title">{trackName}</span>
      <span class="sc-note">{note}</span>
    </span>
  </button>
</div>

<style>
  .sc-player {
    background: var(--c-base);
    color: var(--c-content);
  }

  .sc-load {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    padding: 1.25rem;
    text-align: left;
    cursor: pointer;
  }

  .sc-play {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    flex: none;
    background: var(--c-primary);
    color: var(--c-base);
    transition:
      background-color 0.2s,
      transform 0.25s var(--ease-out);
  }

  .sc-play svg {
    width: 1.25rem;
    height: 1.25rem;
    margin-left: 0.2rem;
  }

  .sc-load:hover .sc-play,
  .sc-load:focus-visible .sc-play {
    background: var(--c-content);
    transform: scale(1.06);
  }

  .sc-load:active .sc-play {
    transform: scale(0.96);
  }

  .sc-text {
    min-width: 0;
  }

  .sc-title {
    display: block;
    font-size: var(--t-lead);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    hyphens: auto;
  }

  @media (max-width: 480px) {
    .sc-title {
      font-size: 1.375rem;
    }

    .sc-play {
      width: 3.25rem;
      height: 3.25rem;
    }
  }

  .sc-note {
    display: block;
    margin-top: 0.35rem;
    font-size: var(--t-small);
    color: var(--c-soft);
  }
</style>

<script>
  // Swap the facade for the real iframe on first interaction.
  document.querySelectorAll<HTMLElement>(".sc-player").forEach((player) => {
    const btn = player.querySelector(".sc-load");
    btn?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = player.dataset.embedSrc ?? "";
      iframe.width = "100%";
      iframe.height = "166";
      iframe.setAttribute("allow", "autoplay");
      iframe.setAttribute("title", "SoundCloud player — DAY SHO");
      iframe.style.border = "0";
      iframe.style.display = "block";
      btn.replaceWith(iframe);
    });
  });
</script>
