---
import Micro from "./Micro.astro";

// Section D — DESTROYED_STAGES.LOG: vertical event log, printed line-by-line on scroll.
import { STAGES as stages } from "../data/bio";
---

<section id="stages" class="shell py-20 md:py-28">
  <h2 class="font-mono text-2xl font-bold uppercase tracking-widest text-content md:text-4xl">
    <span class="text-primary">//</span> DESTROYED_STAGES.LOG<span class="cursor-blink"></span>
  </h2>
  <p class="mt-2 flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-muted">
    <Micro name="tickStrip" class="h-3 w-[70px] text-primary" />
    EVENT HISTORY // VERIFIED IMPACT REPORTS
  </p>

  <ol id="stage-log" class="mt-10 border-l border-[#333]">
    {
      stages.map((stage) => (
        <li class="log-entry relative py-5 pl-6 md:pl-10">
          <span class="absolute -left-[5px] top-7 h-[9px] w-[9px] bg-primary" aria-hidden="true" />
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <span class="font-mono text-xs tracking-widest text-muted">{stage.id}</span>
            <span
              class:list={[
                "font-mono text-[11px] uppercase tracking-widest",
                stage.tag === "ACTIVE" ? "text-primary" : "text-content/70",
              ]}
            >
              [{stage.tag}]
            </span>
          </div>
          <h3 class="mt-1 font-display text-2xl font-bold uppercase tracking-tight text-content md:text-4xl">
            {stage.event}
          </h3>
          <p class="mt-1 font-mono text-sm uppercase tracking-wider text-muted">{stage.venue}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* Each entry is wiped in left-to-right in discrete steps, like a line being
     printed to a terminal. Stays visible if JS never runs (no .is-in dependency
     for the base state under reduced motion). */
  .log-entry {
    opacity: 0;
    clip-path: inset(0 100% 0 0);
  }

  .log-entry.is-in {
    animation:
      log-print 0.5s steps(14, end) forwards,
      log-fade 0.12s linear forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes log-print {
    to { clip-path: inset(0 0 0 0); }
  }

  @keyframes log-fade {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .log-entry {
      opacity: 1;
      clip-path: none;
    }
    .log-entry.is-in { animation: none; }
  }
</style>

<script>
  // ponytail: IntersectionObserver + a CSS class. This replaced gsap + ScrollTrigger
  // (44 kB) for what is ultimately "add a class when it scrolls into view".
  const entries = document.querySelectorAll<HTMLElement>(".log-entry");

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const io = new IntersectionObserver(
      (records, obs) => {
        records.forEach((r) => {
          if (!r.isIntersecting) return;
          const el = r.target as HTMLElement;
          el.style.setProperty("--d", `${(Number(el.dataset.i) % 3) * 90}ms`);
          el.classList.add("is-in");
          obs.unobserve(el);
        });
      },
      { rootMargin: "0px 0px -12% 0px" }
    );

    entries.forEach((el, i) => {
      el.dataset.i = String(i);
      io.observe(el);
    });
  } else {
    entries.forEach((el) => el.classList.add("is-in"));
  }
</script>
