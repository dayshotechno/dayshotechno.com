---
// The name as a monument. The photograph is cut at his shoulders, right where
// "DAY SHO" is printed across the back of his shirt in the full frame, and the
// name continues underneath at full width: the print, blown up to the room.
import StepArrow from "./StepArrow.astro";

const links = [
  { href: "#listen", label: "Listen" },
  { href: "#bio", label: "Bio" },
  { href: "#stages", label: "Stages" },
  { href: "#rider", label: "Rider" },
  { href: "#press", label: "Press" },
];
---

<header class="hero">
  <figure class="hero-photo">
    <picture>
      <source media="(max-width: 767px)" srcset="/assets/hero_tall.webp" width="900" height="996" />
      <img
        src="/assets/hero_wide@1440.webp"
        srcset="/assets/hero_wide@1440.webp 1440w, /assets/hero_wide.webp 2400w"
        sizes="100vw"
        alt="DAY SHO seen from behind at the decks, headphones on, facing a full room under white beams"
        width="1440"
        height="616"
        fetchpriority="high"
      />
    </picture>
  </figure>

  <nav class="hero-nav shell" aria-label="Sections">
    <a href="/" class="hero-mark" aria-label="DAY SHO, home">
      <img src="/assets/logo-day-sho.svg" alt="" width="765" height="1000" />
    </a>
    <ul class="hero-links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <a href="#booking" class="btn btn--red hero-book">Book</a>
  </nav>

  <div class="hero-band shell">
    <h1 class="hero-name">DAY SHO</h1>

    <div class="hero-row">
      <p class="hero-sentence">
        Schranz DJ from Graz, Austria. 145 to 160 BPM, no breaks, best after the headliner.
      </p>
      <a href="#booking" class="btn btn--red hero-cta">
        Send a booking request
        <StepArrow />
      </a>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100svh;
    min-height: 40rem;
    background: var(--c-base);
    overflow: hidden;
  }

  /* ---- Photograph: full bleed, top of the screen -------------------- */
  .hero-photo {
    position: relative;
    grid-row: 1;
    grid-column: 1;
    min-height: 0;
    overflow: hidden;
  }

  .hero-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* His head sits just right of centre; keep the shoulders on the cut. */
    object-position: 50% 100%;
    filter: grayscale(1) contrast(1.18) brightness(0.92);
    animation: hero-settle 2.2s var(--ease-out) both;
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.08);
      opacity: 0;
    }
  }

  /* ---- Navigation over the photograph's top edge -------------------- */
  .hero-nav {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.5rem);
    padding-block: clamp(1rem, 2.4vw, 1.75rem);
  }

  /* Neutral scrim behind the nav row only: the beams are bright up there. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 9rem;
    z-index: 1;
    background: linear-gradient(rgb(5 5 5 / 0.7), rgb(5 5 5 / 0)); /* taste-skill-ignore: neutral scrim over the photo */
    pointer-events: none;
  }

  .hero-mark {
    display: block;
    width: 2.6rem;
    margin-right: auto;
    transition: transform 0.25s var(--ease-out);
  }

  .hero-mark:hover {
    transform: rotate(-4deg) scale(1.06);
  }

  .hero-mark img {
    width: 100%;
    height: auto;
  }

  .hero-links {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.25rem);
    font-size: var(--t-body);
    font-weight: 500;
  }

  .hero-links a {
    position: relative;
    padding-block: 0.5rem;
    transition: color 0.2s;
  }

  .hero-links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.2rem;
    height: 2px;
    background: var(--c-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-out);
  }

  .hero-links a:hover,
  .hero-links a:focus-visible {
    color: var(--c-primary);
  }

  .hero-links a:hover::after,
  .hero-links a:focus-visible::after {
    transform: scaleX(1);
  }

  .hero-book {
    min-height: 2.75rem;
    padding: 0.6rem 1.1rem;
  }

  /* ---- The band under the photograph -------------------------------- */
  .hero-band {
    position: relative;
    z-index: 1;
    grid-row: 2;
    padding-block: 0 clamp(1.25rem, 2.6vw, 2rem);
  }

  .hero-row {
    margin-top: clamp(1.25rem, 2.4vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    animation: hero-rise 0.8s var(--ease-out) 0.35s both;
  }

  .hero-sentence {
    max-width: 34ch;
    font-size: var(--t-lead);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .hero-cta {
    flex: none;
  }

  /* Sized against the frame so "DAY SHO" runs margin to margin on one line. */
  .hero-name {
    display: block;
    /* Sits flush on the photograph's cut, where the shirt print would be. */
    margin-top: 0.02em;
    margin-inline: -0.035em;
    font-size: calc((min(100vw, var(--maxw) + var(--gutter) * 2) - var(--gutter) * 2) / 3.66);
    font-weight: 700;
    line-height: 0.74;
    letter-spacing: -0.055em;
    white-space: nowrap;
    color: var(--c-primary);
    padding-bottom: 0.06em;
    transform-origin: 50% 100%;
    animation: hero-rise 0.9s var(--ease-out) 0.15s both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  /* Signature move: the monument sinks a little as the first screen leaves. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-band {
        animation: hero-sink linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @keyframes hero-sink {
    to {
      transform: scale(0.93);
      opacity: 0.35;
    }
  }

  /* ---- Tablet and phone --------------------------------------------- */
  @media (max-width: 1023px) {
    .hero-links {
      display: none;
    }

    .hero-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 767px) {
    .hero {
      height: auto;
      min-height: 0;
      grid-template-rows: 56svh auto;
    }

    .hero-photo img {
      object-position: 50% 100%;
    }

    .hero-band {
      padding-bottom: 2rem;
    }

    .hero-row {
      gap: 1.25rem;
    }

    .hero-sentence {
      font-size: 1.25rem;
    }

    .hero-cta {
      width: 100%;
      justify-content: space-between;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo img,
    .hero-row,
    .hero-name {
      animation: none;
    }
  }
</style>
