---
import SoundCloudPlayer from "./SoundCloudPlayer.astro";
import Micro from "./Micro.astro";
import { CLAIM } from "../data/bio";
import dims from "../data/images.json";

// Profile frame: the figure faces left, into the copy. A front-facing shot looks
// out of the page and competes with the claim.
const FIGURE = "studio_side";
const figure = dims[FIGURE];
const figureSm = dims[`${FIGURE}@700`];
---

<header class="hero">
  <div class="blueprint absolute inset-[-20%] z-0" data-parallax aria-hidden="true"></div>

  <!-- Figure occupies grid columns 8–12 and is bottom-anchored. Its right edge sits
       on the container edge, so it can never be clipped by the viewport. -->
  <div class="hero-figure" aria-hidden="true">
    <picture class="hero-figure__slot">
      <source media="(max-width: 1023px)" srcset="/assets/press_04.webp" />
      <img
        src={`/assets/${FIGURE}.webp`}
        srcset={`/assets/${FIGURE}@700.webp ${figureSm.w}w, /assets/${FIGURE}.webp ${figure.w}w`}
        sizes="42vw"
        alt=""
        width={figure.w}
        height={figure.h}
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>

  <div class="scan-beam z-10" aria-hidden="true"></div>

  <!-- Corner brackets ride the same shell as everything else -->
  <div class="hero-frame" aria-hidden="true">
    <span class="hero-bracket hero-bracket--tl"></span>
    <span class="hero-bracket hero-bracket--br"></span>
  </div>

  <!-- ROW 1 — mark + telemetry -->
  <div class="hero-row shell g12">
    <a href="/" class="hero-stagger hero-mark" style="--d:0ms" aria-label="DAY SHO — home">
      <img src="/assets/logo-day-sho.svg" alt="DAY SHO" width="765" height="1000" />
    </a>

    <div class="hero-stagger hero-hud" style="--d:60ms" aria-hidden="true">
      <Micro name="reticle" class="hud-reticle text-scan" />
      <div>
        <span class="text-scan">●</span> SCAN_ACTIVE<br />
        LAT 47.0707 / LON 15.4395<br />
        SIGNAL: HARD_TECHNO
      </div>
    </div>
  </div>

  <!-- ROW 2 — claim block, columns 1–7 -->
  <div class="hero-row hero-row--main shell g12">
    <div class="hero-copy">
      <div class="hero-stagger hero-eyebrow" style="--d:120ms">
        <Micro name="tickStrip" class="eyebrow-ticks text-primary" />
        <p>HARD TECHNO / SCHRANZ</p>
      </div>

      <!-- Sized in cqw against this column, so the longest word can never outgrow it. -->
      <h1 class="claim">
        {
          CLAIM.map((word, i) => (
            <span class="hero-stagger claim-line" data-stage={i} style={`--d:${190 + i * 90}ms`}>
              {word}
            </span>
          ))
        }
      </h1>

      <div class="hero-stagger hero-player" style="--d:520ms">
        <SoundCloudPlayer trackUrl="https://soundcloud.com/user-110221213/schranzlangenvergleich" />
      </div>
    </div>
  </div>

  <!-- ROW 3 — status line + scroll cue -->
  <div class="hero-row hero-row--foot shell g12">
    <div class="hero-stagger hero-status" style="--d:600ms">
      <Micro name="stepSeq" class="status-seq text-muted" />
      <p>GRAZ / AT — AVAILABLE FOR BOOKING</p>
    </div>

    <a href="#audio-feed" aria-label="Scroll to content" class="hero-arrow">
      <Micro name="stepArrowDown" class="w-full" />
    </a>
  </div>
</header>

<style>
  /* ============================================================
     Hero shell: exactly one viewport tall, three rows, no overflow.
     ============================================================ */
  .hero {
    position: relative;
    height: 100dvh;
    min-height: 34rem;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    row-gap: clamp(0.5rem, 2vh, 2rem);
    padding-block: clamp(1rem, 3vh, 2.5rem);
    overflow: hidden;
    background: var(--c-base);
  }

  .hero-row {
    position: relative;
    z-index: 20;
    align-items: start;
  }

  .hero-row--main {
    align-content: center;
    min-height: 0;
  }

  .hero-row--foot {
    align-items: end;
  }

  /* ---- Row 1 ---------------------------------------------------- */
  .hero-mark {
    grid-column: 1 / span 2;
    display: block;
    max-width: 7.25rem;
  }

  .hero-mark img {
    width: 100%;
    height: auto;
  }

  .hero-hud {
    grid-column: 9 / span 4;
    justify-self: end;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    border: 1px solid #333;
    background: rgb(10 10 10 / 0.8);
    padding: 0.5rem 0.75rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-muted);
    backdrop-filter: blur(2px);
  }

  .hud-reticle {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    margin-top: 2px;
  }

  /* ---- Row 2: the copy column ------------------------------------ */
  .hero-copy {
    grid-column: 1 / span 7;
    /* Establishes the query container the claim scales against. */
    container-type: inline-size;
    min-width: 0;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-eyebrow p {
    font-family: "JetBrains Mono", monospace;
    font-size: clamp(0.7rem, 0.85cqw, 0.875rem);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--c-primary);
  }

  .eyebrow-ticks {
    width: 70px;
    height: 13px;
    flex: none;
  }

  .claim {
    display: flex;
    flex-direction: column;
    margin-top: clamp(0.75rem, 1.6vh, 1.5rem);
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.84;
    letter-spacing: -0.025em;
  }

  /* Two constraints at once: cqw keeps each line inside its 7-column box,
     vh keeps the block inside the viewport on short windows. Whichever binds
     first wins, so the claim fits both ways without a media query. */
  .claim-line {
    display: block;
    white-space: nowrap;
  }

  .claim-line[data-stage="0"] {
    font-size: min(14.4cqw, 15.4vh);
    color: var(--c-primary);
    text-shadow: 0.028em 0.028em 0 rgb(255 42 42 / 0.22);
  }

  .claim-line[data-stage="1"] {
    font-size: min(11.5cqw, 12.3vh);
    color: var(--c-content);
  }

  .claim-line[data-stage="2"] {
    font-size: min(7.3cqw, 7.8vh);
    color: var(--c-muted);
  }

  .hero-player {
    margin-top: clamp(1rem, 3vh, 2.25rem);
    max-width: 34rem;
  }

  /* ---- Row 3 ------------------------------------------------------ */
  .hero-status {
    grid-column: 1 / span 6;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hero-status p {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .status-seq {
    width: 120px;
    height: 9px;
    flex: none;
  }

  .hero-arrow {
    grid-column: 7 / span 1;
    justify-self: end;
    display: block;
    width: 2.25rem;
    color: var(--c-primary);
    animation: arrow-invite 1.6s ease-in-out infinite;
  }

  /* ---- Figure: columns 8–12, bottom anchored, never clipped --------
     Sized off the shell's own width (percentages of this box) rather than 100vw,
     so it lands on the same edge as the HUD even when a scrollbar is present. */
  .hero-figure,
  .hero-frame {
    position: absolute;
    inset-block: 0;
    inset-inline: 0;
    margin-inline: auto;
    width: min(100% - var(--gutter) * 2, var(--maxw));
    pointer-events: none;
  }

  .hero-figure {
    z-index: 5;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }

  .hero-frame {
    z-index: 20;
    inset-block: clamp(1rem, 3vh, 2.5rem);
  }

  .hero-figure__slot {
    width: calc((100% - 11 * var(--gap)) / 12 * 5 + var(--gap) * 4);
    height: 94%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }

  .hero-figure img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    /* Dissolve the left edge into the page so no photo boundary shows next to
       the copy; the right side is the subject's back and already near-black. */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 38%);
    mask-image: linear-gradient(to right, transparent, #000 38%);
    filter: grayscale(0.55) contrast(1.12);
  }

  /* ---- Corner brackets on the container edge ----------------------- */
  .hero-bracket {
    position: absolute;
    z-index: 20;
    width: 2rem;
    height: 2rem;
    pointer-events: none;
  }

  .hero-bracket--tl {
    left: 0;
    top: 0;
    border-left: 2px solid var(--c-primary);
    border-top: 2px solid var(--c-primary);
  }

  .hero-bracket--br {
    right: 0;
    bottom: 0;
    border-right: 2px solid var(--c-primary);
    border-bottom: 2px solid var(--c-primary);
  }

  /* ---- Below the desktop grid -------------------------------------- */
  @media (max-width: 1023px) {
    .hero {
      min-height: 42rem;
      background: #050505;
    }

    .hero-mark {
      grid-column: 1 / span 4;
      max-width: 4.75rem;
    }

    .hero-hud { display: none; }
    .hero-copy { grid-column: 1 / span 12; }
    .hero-status { grid-column: 1 / span 10; }
    .hero-arrow { grid-column: 11 / span 2; }

    .claim-line[data-stage="0"] { font-size: min(14.4cqw, 12.4vh); }
    .claim-line[data-stage="1"] { font-size: min(11.5cqw, 9.9vh); }
    .claim-line[data-stage="2"] { font-size: min(7.3cqw, 6.3vh); }

    .hero-figure {
      width: 100%;
      opacity: 1;
    }

    .hero-figure__slot {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }

    .hero-figure__slot::after {
      content: "";
      position: absolute;
      z-index: 1;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(
          to bottom,
          rgba(5, 5, 5, 0.16) 0%,
          rgba(5, 5, 5, 0.3) 32%,
          rgba(5, 5, 5, 0.72) 66%,
          rgba(5, 5, 5, 0.96) 100%
        ),
        linear-gradient(to right, rgba(5, 5, 5, 0.34), transparent 72%);
    }

    .hero-figure__slot img {
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      object-fit: cover;
      object-position: center;
      opacity: 0.88;
      filter: grayscale(0.55) contrast(1.18) brightness(0.7);
      -webkit-mask-image: none;
      mask-image: none;
    }

    .status-seq {
      display: none;
    }

    .hero-status {
      gap: 0;
    }

    :global(.hero-player .sc-load) {
      gap: 0.85rem;
      padding: 1rem;
    }

    :global(.hero-player .sc-load > span:first-child) {
      width: 2.8rem;
      height: 2.8rem;
    }
  }

  /* Short windows: the player is the first thing to go — it is repeated in
     full in the AUDIO_FEED section directly below. */
  @media (max-height: 640px) {
    .hero-player { display: none; }
  }

  /* ---- Motion ------------------------------------------------------ */
  .hero-stagger {
    animation: hero-rise 0.65s cubic-bezier(0.2, 0.75, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
  }

  @keyframes arrow-invite {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(9px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-stagger,
    .hero-arrow {
      animation: none;
    }
  }
</style>

<script>
  // Grid parallax at 0.5x scroll speed. ponytail: rAF-throttled scroll listener,
  // ~15 lines of transform maths — this is what GSAP used to be loaded for.
  const grid = document.querySelector<HTMLElement>("[data-parallax]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (grid && !reduced) {
    let ticking = false;
    addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          grid.style.transform = `translateY(${scrollY * 0.5}px)`;
          ticking = false;
        });
      },
      { passive: true }
    );
  }

  // ?grid toggles the column overlay while tuning the layout.
  if (location.search.includes("grid")) document.body.dataset.grid = "";
</script>
