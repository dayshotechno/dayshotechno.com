---
// Printable one-sheet: dark on screen, clean black-on-white via @media print.
import Layout from "../layouts/Layout.astro";
import { CLAIM_INLINE, BIO_LONG_BODY, STAGES } from "../data/bio";
---

<Layout title="One-Sheet | DAY SHO" description="Printable one-sheet for DAY SHO. Hard Techno & Schranz DJ." noindex>
  <main id="main" class="one-sheet mx-auto w-full max-w-3xl px-6 py-12">
    <div class="no-print mb-8 flex items-center justify-between gap-4">
      <a href="/" class="glitch-hover font-mono text-xs uppercase tracking-widest text-muted hover:text-primary">&lt; BACK</a>
      <button
        type="button"
        onclick="window.print()"
        class="switch-btn glitch-hover max-w-[220px] !py-3 text-center"
      >
        &gt; PRINT_PDF
      </button>
    </div>

    <header class="flex items-end gap-6 border-b-4 border-primary pb-6">
      <!-- Two cuts of the same mark: white-on-transparent for screen, dark ink for paper. -->
      <img src="/assets/logo-day-sho.svg" alt="DAY SHO" width="765" height="1000" class="onesheet-logo--screen h-28 w-auto" />
      <img src="/assets/logo-day-sho-ink.svg" alt="DAY SHO" width="765" height="1000" class="onesheet-logo--print h-28 w-auto" />
      <p class="font-mono text-xs uppercase tracking-[0.4em]">
        HARD TECHNO / SCHRANZ<br />OFFICIAL ONE-SHEET
      </p>
    </header>

    <section class="mt-8">
      <h2 class="font-mono text-sm font-bold uppercase tracking-widest text-primary">// BIO</h2>
      <p class="mt-3 font-mono text-sm font-bold uppercase tracking-widest">DAY SHO // {CLAIM_INLINE}</p>
      <p class="mt-3 text-sm leading-relaxed">{BIO_LONG_BODY}</p>
    </section>

    <section class="mt-8 grid grid-cols-2 gap-8">
      <div>
        <h2 class="font-mono text-sm font-bold uppercase tracking-widest text-primary">// STAGES</h2>
        <ul class="mt-3 space-y-1 font-mono text-xs uppercase leading-relaxed">
          {STAGES.map((s) => <li>{s.event} — {s.venue.replace(" // ", ", ")}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="font-mono text-sm font-bold uppercase tracking-widest text-primary">// TECH RIDER</h2>
        <ul class="mt-3 space-y-1 font-mono text-xs uppercase leading-relaxed">
          <li>3x Pioneer CDJ-3000 (linked) // alt: 2000NXS2</li>
          <li>1x DJM-A9 // alt: Allen &amp; Heath Xone:96</li>
        </ul>
        <h2 class="mt-6 font-mono text-sm font-bold uppercase tracking-widest text-primary">// CONTACT</h2>
        <p class="mt-3 font-mono text-xs uppercase leading-relaxed">
          booking@dayshotechno.com<br />
          dayshotechno.com<br />
          IG @daysho.techno // TT @daysho.dj
        </p>
      </div>
    </section>
  </main>

  <style>
    /* Swap the logo cut rather than filter-inverting it: inverting the master mark
       would turn the red letters cyan on paper. */
    .onesheet-logo--print { display: none; }

    @media print {
      .one-sheet {
        max-width: 100%;
        color: #000;
      }
      .onesheet-logo--screen { display: none; }
      .onesheet-logo--print { display: block; }
    }
  </style>
</Layout>
