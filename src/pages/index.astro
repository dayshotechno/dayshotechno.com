---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import AudioFeed from "../components/AudioFeed.astro";
import BioSystem from "../components/BioSystem.astro";
import StageTimeline from "../components/StageTimeline.astro";
import Stockdunkel from "../components/Stockdunkel.astro";
import TechRider from "../components/TechRider.astro";
import PressAssets from "../components/PressAssets.astro";
import BookingSection from "../components/BookingSection.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <HeroSection />

  <main id="main">
    <AudioFeed />
    <BioSystem />
    <StageTimeline />
    <Stockdunkel />
    <TechRider />
    <PressAssets />
    <BookingSection />
  </main>

  <Footer />
</Layout>
