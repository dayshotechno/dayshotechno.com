---
// Static site, no backend: the form composes a structured booking request and hands
// it to the promoter's own mail client via mailto.
// ponytail: plain <form> + ~20 lines of script. This was a React island (265 kB of
// runtime) to build a mailto: string. Native constraint validation does the checking.
const BOOKING_EMAIL = "booking@dayshotechno.com";

const BUDGET_RANGES = ["Under 500 EUR", "500–1,000 EUR", "1,000–2,500 EUR", "Over 2,500 EUR", "To be discussed"];

const FIELDS = [
  { name: "name", label: "Your name", required: true, autocomplete: "name" },
  { name: "venue", label: "Club or festival", required: true, autocomplete: "organization" },
  { name: "city", label: "City", required: true, autocomplete: "address-level2" },
  { name: "date", label: "Date", type: "date", required: true },
  { name: "capacity", label: "Capacity", type: "number", placeholder: "e.g. 400", min: "0", inputmode: "numeric" },
];
---

<form id="booking-form" class="bf" data-email={BOOKING_EMAIL}>
  <div class="bf-grid">
    {
      FIELDS.map((f) => (
        <label class="bf-field">
          <span class="bf-label">
            {f.label}
            {f.required && <span class="bf-req"> (required)</span>}
          </span>
          <input
            name={f.name}
            type={f.type ?? "text"}
            required={f.required}
            placeholder={f.placeholder}
            min={f.min}
            inputmode={f.inputmode}
            autocomplete={f.autocomplete}
            class="bf-input"
          />
        </label>
      ))
    }

    <label class="bf-field">
      <span class="bf-label">Budget</span>
      <select name="budget" class="bf-input">
        <option value="">Choose a range</option>
        {BUDGET_RANGES.map((range) => <option value={range}>{range}</option>)}
      </select>
    </label>

    <label class="bf-field bf-field--wide">
      <span class="bf-label">Anything else</span>
      <textarea name="message" rows="3" class="bf-input" placeholder="Line-up, set time, travel"></textarea>
    </label>
  </div>

  <div class="bf-foot">
    <button type="submit" class="btn btn--ink bf-submit">Write the email</button>
    <p id="booking-status" class="small" aria-live="polite">
      <span data-idle>Opens your mail app with everything filled in.</span>
      <span data-sent hidden>Handed to your mail app. Nothing opened? Write to {BOOKING_EMAIL}.</span>
    </p>
  </div>
</form>

<style>
  .bf-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem var(--gap);
  }

  .bf-field {
    display: block;
  }

  .bf-field--wide {
    grid-column: 1 / -1;
  }

  .bf-label {
    display: block;
    font-size: var(--t-small);
    font-weight: 500;
  }

  .bf-req {
    color: #555;
    font-weight: 400;
  }

  /* Form fields keep their bottom rule: it is the field. */
  .bf-input {
    width: 100%;
    margin-top: 0.35rem;
    padding: 0.6rem 0;
    background: transparent;
    border: 0;
    border-bottom: 2px solid var(--c-base);
    color: var(--c-base);
    font: inherit;
    transition: border-color 0.2s;
  }

  .bf-input::placeholder {
    color: #6b6b6b;
  }

  .bf-input:focus {
    outline: none;
    border-bottom-color: var(--c-primary);
  }

  .bf-input:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 4px;
  }

  select.bf-input {
    appearance: none;
    cursor: pointer;
  }

  textarea.bf-input {
    resize: vertical;
  }

  .bf-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.25rem;
  }

  .bf-submit {
    min-width: 14rem;
  }

  /* Phone: name, venue and message full width; the short fields stay in pairs. */
  @media (max-width: 640px) {
    .bf-grid {
      row-gap: 1.25rem;
    }

    .bf-field:nth-child(1),
    .bf-field:nth-child(2) {
      grid-column: 1 / -1;
    }

    .bf-submit {
      width: 100%;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("#booking-form");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? "").trim();

    const subject = `Booking request: DAY SHO – ${get("date") || "[date]"} / ${get("city") || "[city]"}`;
    const body = [
      "Booking request for DAY SHO",
      "",
      `Name:      ${get("name")}`,
      `Venue:     ${get("venue")}`,
      `City:      ${get("city")}`,
      `Date:      ${get("date")}`,
      `Capacity:  ${get("capacity")}`,
      `Budget:    ${get("budget")}`,
      "",
      get("message"),
    ].join("\n");

    const to = form.dataset.email;
    location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    document.querySelector("[data-idle]")?.setAttribute("hidden", "");
    document.querySelector("[data-sent]")?.removeAttribute("hidden");
  });
</script>
