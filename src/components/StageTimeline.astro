---
// Stages: the rooms he has played, set like a line-up — one size, fixed column
// starts, nothing between the rows but leading. Dated gigs and the older, undated
// ones sit in two groups, so no row has an empty date beside it by accident.
import { STAGES, formatDate } from "../data/bio";

const groups = [
  { label: "2026", rows: STAGES.filter((s) => s.date) },
  { label: "Earlier", rows: STAGES.filter((s) => !s.date) },
];
---

<section id="stages" class="stages section">
  <div class="shell">
    <div class="stages-head" data-reveal>
      <h2 class="h2">Stages</h2>
      <p class="soft">Newest first.</p>
    </div>

    <table class="stages-table">
      <caption class="sr-only">Events DAY SHO has played, newest first</caption>
      <thead class="sr-only">
        <tr>
          <th scope="col">Event</th>
          <th scope="col">Venue</th>
          <th scope="col">City</th>
          <th scope="col">Date</th>
        </tr>
      </thead>
      {
        groups.map((g) => (
          <tbody data-reveal>
            <tr class="stage-group">
              <th scope="colgroup" colspan="4">{g.label}</th>
            </tr>
            {g.rows.map((s) => (
              <tr>
                <th scope="row">{s.event}</th>
                <td>{s.venue}</td>
                <td>{s.city}</td>
                <td class="stage-date tabular">
                  {s.date && <time datetime={s.date}>{formatDate(s.date)}</time>}
                </td>
              </tr>
            ))}
          </tbody>
        ))
      }
    </table>

    <p class="stages-foot lead" data-reveal>
      <span>Shared bills with Jan Vanderveigt and 333CXT.</span>
    </p>
  </div>
</section>

<style>
  .stages {
    background: var(--c-surface);
  }

  .stages-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .stages-table {
    width: 100%;
    border-collapse: collapse;
    font-size: clamp(1.375rem, 0.9rem + 1.8vw, 2.5rem);
    line-height: 1.45;
    letter-spacing: -0.02em;
  }

  .stages-table th,
  .stages-table td {
    padding: 0;
    text-align: left;
    font-weight: 400;
    vertical-align: baseline;
  }

  .stages-table tbody th {
    width: 46%;
    font-weight: 500;
  }

  .stages-table td:nth-child(2) {
    width: 26%;
  }

  /* Group headings at the row size, in red: part of the line-up, not a label. */
  .stages-table .stage-group th {
    padding-top: 1.2em;
    padding-bottom: 0.15em;
    color: var(--c-primary);
    font-weight: 700;
  }

  .stages-table tbody:first-of-type .stage-group th {
    padding-top: 0;
  }

  .stages-table td {
    color: var(--c-soft);
  }

  .stages-table td.stage-date {
    text-align: right;
    color: var(--c-content);
  }

  .stages-table tbody tr {
    transition: color 0.2s;
  }

  .stages-table tbody tr:not(.stage-group):hover th,
  .stages-table tbody tr:not(.stage-group):hover td {
    color: var(--c-primary);
  }

  .stages-foot {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* The reveal moves rows, not the table body. */
  .js .stages-table tbody[data-reveal] > tr {
    transition-property: opacity, transform, color;
  }

  /* Phone: event on its own line; venue and city on the left, date on the right. */
  @media (max-width: 767px) {
    .stages-table,
    .stages-table tbody,
    .stages-table tr,
    .stages-table th,
    .stages-table td {
      display: block;
      width: auto;
    }

    .stages-table tbody tr:not(.stage-group) {
      display: grid;
      grid-template-columns: max-content max-content 1fr;
      column-gap: 0.4rem;
      padding-block: 0.55rem;
      font-size: var(--t-body);
      letter-spacing: 0;
    }

    .stages-table tbody tr:not(.stage-group) th {
      grid-column: 1 / -1;
      width: auto;
      font-size: 1.375rem;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }

    .stages-table td:nth-child(2)::after {
      content: ",";
    }

    .stages-table .stage-group th {
      font-size: 1.375rem;
    }
  }
</style>
