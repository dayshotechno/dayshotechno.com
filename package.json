{
  "name": "daysho-epk",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "DAY SHO — Electronic Press Kit. Brutalist single-page Astro build.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "assets": "node scripts/prepare-assets.js",
    "presskit": "node scripts/make-presskit.js && powershell -NoProfile -Command \"Compress-Archive -Path build/presskit/* -DestinationPath public/downloads/presskit.zip -Force\"",
    "make:og": "node scripts/make-og.js"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.0",
    "astro": "^5.7.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "typescript": "^5.7.0"
  }
}
