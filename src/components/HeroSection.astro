---
import SoundCloudPlayer from "./SoundCloudPlayer.astro";
import Micro from "./Micro.astro";

import { CLAIM } from "../data/bio";
import dims from "../data/images.json";

// Profile frame: the figure faces left, into the copy. A front-facing shot looks
// out of the page and competes with the claim.
const FIGURE = "studio_side";
const figure = dims[FIGURE];
const figureSm = dims[`${FIGURE}@700`];
---

<header class="hero relative flex min-h-screen flex-col overflow-hidden bg-void">
  <!-- Blueprint grid, parallaxed at 0.5x -->
  <div class="blueprint absolute inset-[-20%] z-0" data-parallax aria-hidden="true"></div>

  <!-- Studio figure. The source frame's backdrop is already near-black, so it dissolves
       into the page instead of sitting in a visible box. -->
  <div class="hero-figure" aria-hidden="true">
    <img
      src={`/assets/${FIGURE}.webp`}
      srcset={`/assets/${FIGURE}@700.webp ${figureSm.w}w, /assets/${FIGURE}.webp ${figure.w}w`}
      sizes="(max-width: 1024px) 60vw, 45vw"
      alt=""
      width={figure.w}
      height={figure.h}
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="scan-beam z-10" aria-hidden="true"></div>

  <!-- HUD: telemetry block -->
  <div class="absolute right-4 top-4 z-20 hidden md:block" aria-hidden="true">
    <div class="flex items-start gap-3 border border-[#333] bg-surface/80 px-3 py-2 font-mono text-[11px] uppercase tracking-widest text-muted backdrop-blur-sm">
      <Micro name="reticle" class="mt-[2px] h-6 w-6 text-scan" />
      <div>
        <span class="text-scan">●</span> SCAN_ACTIVE<br />
        LAT 47.0707 / LON 15.4395<br />
        SIGNAL: HARD_TECHNO
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute left-4 top-4 z-20 h-8 w-8 border-l-2 border-t-2 border-primary" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-4 right-4 z-20 h-8 w-8 border-b-2 border-r-2 border-primary" aria-hidden="true"></div>

  <div class="relative z-20 mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-4 pb-8 pt-24 md:pt-20">
    <div class="max-w-[62ch]">
      <a href="/" class="hero-stagger block w-[clamp(72px,9vw,116px)]" style="--d:0ms" aria-label="DAY SHO — home">
        <img src="/assets/logo-day-sho.svg" alt="DAY SHO" width="765" height="1000" class="w-full" />
      </a>

      <div class="hero-stagger mt-7 flex items-center gap-3" style="--d:80ms">
        <Micro name="tickStrip" class="h-3 w-[70px] text-primary" />
        <p class="font-mono text-xs uppercase tracking-[0.4em] text-primary md:text-sm">
          HARD TECHNO / SCHRANZ
        </p>
      </div>

      <!-- Claim. Each stage is set larger than the last: the type is the gain curve. -->
      <h1 class="claim mt-5 font-display font-bold uppercase text-content">
        {
          CLAIM.map((word, i) => (
            <span class="hero-stagger claim-line" data-stage={i} style={`--d:${160 + i * 90}ms`}>
              {word}
            </span>
          ))
        }
      </h1>

      <div class="hero-stagger mt-9 flex items-center gap-4" style="--d:460ms">
        <Micro name="stepSeq" class="hidden h-3 w-[120px] text-muted sm:block" />
        <p class="font-mono text-[11px] uppercase tracking-widest text-muted">
          GRAZ / AT — AVAILABLE FOR BOOKING
        </p>
      </div>

      <div class="hero-stagger mt-6 w-full max-w-xl" style="--d:540ms">
        <SoundCloudPlayer trackUrl="https://soundcloud.com/user-110221213/schranzlangenvergleich" />
      </div>
    </div>
  </div>

  <a
    href="#audio-feed"
    aria-label="Scroll to content"
    class="hero-arrow relative z-20 mx-auto mb-6 block w-10 text-primary"
  >
    <Micro name="stepArrowDown" class="w-full" />
  </a>
</header>

<style>
  /* ---- Figure: bleeds off the right edge, masked into the page background ---- */
  .hero-figure {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }

  .hero-figure img {
    position: absolute;
    right: -6%;
    bottom: 0;
    height: 92%;
    width: auto;
    max-width: none;
    object-fit: contain;
    object-position: bottom right;
    /* Dissolve the frame edges so no photo boundary is visible against the page. */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 42%),
      linear-gradient(to top, transparent 2%, #000 22%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 42%),
      linear-gradient(to top, transparent 2%, #000 22%);
    mask-composite: intersect;
    filter: grayscale(0.55) contrast(1.12);
  }

  @media (max-width: 1023px) {
    .hero-figure img {
      right: -22%;
      height: 74%;
      opacity: 0.38;
    }
  }

  /* ---- Claim: three escalating stages ---- */
  .claim {
    display: flex;
    flex-direction: column;
    line-height: 0.86;
    letter-spacing: -0.02em;
  }

  .claim-line {
    display: block;
    white-space: nowrap;
  }

  /* Descending: the loudest word carries the most weight, then the chain is
     traced back to its source. DESTRUCTION leads, DRIVE closes. */
  .claim-line[data-stage="0"] {
    font-size: clamp(3rem, 9.6vw, 8.4rem);
    color: var(--c-primary);
    text-shadow: 3px 3px 0 rgba(255, 42, 42, 0.22);
  }

  .claim-line[data-stage="1"] {
    font-size: clamp(2.5rem, 7.6vw, 6.6rem);
    color: var(--c-content);
  }

  .claim-line[data-stage="2"] {
    font-size: clamp(1.9rem, 5.4vw, 4.6rem);
    color: var(--c-muted);
  }

  /* ---- Entrance stagger (replaces GSAP; --d set per element) ---- */
  .hero-stagger {
    animation: hero-rise 0.65s cubic-bezier(0.2, 0.75, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
  }

  .hero-arrow {
    animation: arrow-invite 1.6s ease-in-out infinite;
  }

  @keyframes arrow-invite {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(9px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-stagger,
    .hero-arrow {
      animation: none;
    }
  }
</style>

<script>
  // Grid parallax at 0.5x scroll speed. ponytail: rAF-throttled scroll listener,
  // ~15 lines of transform maths — this is what GSAP used to be loaded for.
  const grid = document.querySelector<HTMLElement>("[data-parallax]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (grid && !reduced) {
    let ticking = false;
    addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          grid.style.transform = `translateY(${scrollY * 0.5}px)`;
          ticking = false;
        });
      },
      { passive: true }
    );
  }
</script>
