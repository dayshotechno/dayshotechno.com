---
// Stages: the rooms he has played, set like a line-up — one size, fixed column
// starts, nothing between the rows but leading.
import { STAGES } from "../data/bio";
---

<section id="stages" class="stages section">
  <div class="shell">
    <div class="stages-head" data-reveal>
      <h2 class="h2">Stages</h2>
      <p class="soft">Newest first.</p>
    </div>

    <table class="stages-table">
      <caption class="sr-only">Events DAY SHO has played, newest first</caption>
      <thead class="sr-only">
        <tr>
          <th scope="col">Event</th>
          <th scope="col">Venue</th>
          <th scope="col">City</th>
        </tr>
      </thead>
      <tbody data-reveal>
        {
          STAGES.map((s) => (
            <tr>
              <th scope="row">{s.event}</th>
              <td>{s.venue}</td>
              <td>{s.city}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p class="stages-foot lead" data-reveal>
      <span>Shared bills with Jan Vanderveigt and 333CXT.</span>
    </p>
  </div>
</section>

<style>
  .stages {
    background: var(--c-surface);
  }

  .stages-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .stages-table {
    width: 100%;
    border-collapse: collapse;
    font-size: clamp(1.375rem, 0.9rem + 2vw, 2.75rem);
    line-height: 1.45;
    letter-spacing: -0.02em;
  }

  .stages-table th,
  .stages-table td {
    padding: 0;
    text-align: left;
    font-weight: 400;
    vertical-align: baseline;
  }

  .stages-table tbody th {
    width: 48%;
    font-weight: 500;
  }

  .stages-table td {
    color: var(--c-soft);
  }

  .stages-table td:last-child {
    text-align: right;
  }

  .stages-table tbody tr {
    transition: color 0.2s;
  }

  .stages-table tbody tr:hover th,
  .stages-table tbody tr:hover td {
    color: var(--c-primary);
  }

  .stages-foot {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* The reveal moves rows, not the table body. */
  .js .stages-table tbody[data-reveal] > tr {
    transition-property: opacity, transform, color;
  }

  @media (max-width: 767px) {
    .stages-table,
    .stages-table tbody,
    .stages-table tr,
    .stages-table th,
    .stages-table td {
      display: block;
    }

    .stages-table tbody tr {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: 1rem;
      padding-block: 0.6rem;
    }

    .stages-table tbody th {
      grid-column: 1 / -1;
      width: auto;
      font-size: 1.375rem;
      line-height: 1.2;
    }

    .stages-table td {
      font-size: 1rem;
      letter-spacing: 0;
    }
  }
</style>
